{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orchard boot manifest v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "device": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "boot_method": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "min_orchard": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "protocol": {
      "type": "integer",
      "minimum": 1
    },
    "boot": {
      "$ref": "#/$defs/receipt"
    },
    "pongo": {
      "$ref": "#/$defs/receipt"
    },
    "kind": {
      "const": "orchard.boot"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "loader": {
      "$ref": "#/$defs/receipt"
    },
    "ibec": {
      "$ref": "#/$defs/receipt"
    },
    "kloader": {
      "$ref": "#/$defs/receipt"
    },
    "private": {
      "type": "boolean"
    },
    "target_ecid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    }
  },
  "required": [
    "schema",
    "kind",
    "device",
    "boot_method",
    "min_orchard",
    "protocol",
    "boot"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "boot_method": {
            "const": "checkm8-pongo"
          }
        },
        "required": [
          "boot_method"
        ]
      },
      "then": {
        "required": [
          "pongo"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "boot_method": {
            "const": "jailbreak-kdfu"
          }
        },
        "required": [
          "boot_method"
        ]
      },
      "then": {
        "required": [
          "loader",
          "ibec",
          "kloader",
          "private",
          "target_ecid"
        ],
        "properties": {
          "device": {
            "const": "p105"
          },
          "private": {
            "const": true
          }
        }
      }
    }
  ],
  "$defs": {
    "receipt": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "bytes",
        "sha256"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "file"
          ],
          "not": {
            "required": [
              "url"
            ]
          }
        },
        {
          "required": [
            "url"
          ],
          "not": {
            "required": [
              "file"
            ]
          }
        }
      ]
    }
  }
}
